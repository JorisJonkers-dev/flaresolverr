{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>JorisJonkers-dev/renovate-config"],
  "packageRules": [
    {
      "description": "A flaresolverr minor or patch release merges once Pipeline Complete passes, and release.yml publishes it as this repository's version.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["flaresolverr/flaresolverr"],
      "matchUpdateTypes": ["minor", "patch"],
      "semanticCommitType": "feat",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "A flaresolverr major release waits for approval on the Dependency Dashboard.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["flaresolverr/flaresolverr"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "A digest moved under the same tag is no new version, so it cannot be released.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["flaresolverr/flaresolverr"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]
}
